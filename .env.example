# Absolute origin of the deployed site. Drives canonicals, Open Graph URLs,
# sitemap entries, RSS links and JSON-LD. A trailing slash, a stray path or a
# missing scheme are all normalised away, so "example.com" works too.
#
# Optional on Vercel: with this unset or empty, the build falls back to
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL, then to NEXT_PUBLIC_VERCEL_URL,
# then to https://nextjsblog.com.
NEXT_PUBLIC_SITE_URL=https://nextjsblog.com

# The OSS preview exposes the complete Studio as a read-only product tour.
# Set this to false before building if repository drafts must remain private.
# Local development authoring remains available either way.
STUDIO_DEMO_ENABLED=true
